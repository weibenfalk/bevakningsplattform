{
  "name": "bevakningsplattform",
  "version": "0.1.0",
  "private": true,
  "license": "0BSD",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "migrate": "ts-node scripts/migrate.ts",
    "demo": "ts-node scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --testPathIgnorePatterns /node_modules/ /kanda-fel/",
    "test:kanda-fel": "jest --runInBand kanda-fel"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "marked": "^15.0.7",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "glob": "^11.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "setupFiles": [
      "reflect-metadata"
    ]
  }
}
