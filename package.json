{
  "name": "bevakningsplattform",
  "version": "0.1.0",
  "private": true,
  "license": "0BSD",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "migrate": "ts-node scripts/migrate.ts",
    "demo": "ts-node scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --testPathIgnorePatterns /node_modules/ /kanda-fel/",
    "test:kanda-fel": "jest --runInBand --passWithNoTests kanda-fel"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "glob": "^13.0.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "setupFiles": [
      "reflect-metadata"
    ]
  },
  "engines": {
    "node": ">=22.12"
  }
}
